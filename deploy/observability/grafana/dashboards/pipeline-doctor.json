      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(increase(pd_investigations_total{outcome=\"ok\"}[24h])) / clamp_min(sum(increase(pd_investigations_total[24h])), 1)",
