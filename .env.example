# Copy to .env (git-ignored). Placeholders only; never commit real values.

# --- LLM (ADK defaults to Gemini; LiteLLM model strings also work) ---
GOOGLE_API_KEY=changeme
SMALL_MODEL=gemini-2.5-flash
LARGE_MODEL=gemini-2.5-pro

# --- Ingress ---
WEBHOOK_SHARED_SECRET=changeme
INGRESS_ADDR=:8080
IDEMPOTENCY_TTL=24h

# --- Queue ---
REDIS_URL=redis://localhost:6379/0
MAX_ATTEMPTS=3
QUEUE_GROUP=pipeline-doctor
QUEUE_CONSUMER=worker-1
QUEUE_MIN_IDLE_MS=60000
QUEUE_BLOCK_MS=2000

# --- MCP servers: mock mode needs no credentials (mock | real) ---
MCP_MODE=mock
FIXTURES_DIR=fixtures
JENKINS_MCP_COMMAND=jenkins-mcp
# JIRA_MCP_COMMAND / GITHUB_MCP_COMMAND default to "python -m pd_mcp_jira" / "python -m pd_mcp_github"
GITHUB_WEB_URL=https://github.com
JENKINS_URL=http://localhost:8081
JENKINS_USER=changeme
JENKINS_API_TOKEN=changeme
JENKINS_REBUILD_ENABLED=false
GITHUB_REPO=owner/demo-repo
GITHUB_TOKEN=changeme
JIRA_URL=https://example.atlassian.net
JIRA_USER=changeme
JIRA_API_TOKEN=changeme
JIRA_PROJECT_KEY=DEMO

# --- RAG ---
DATABASE_URL=postgresql://postgres:changeme@localhost:5432/pipeline_doctor
POSTGRES_PASSWORD=changeme
# gemini needs GOOGLE_API_KEY; hash is offline and deterministic but not semantic (demos/tests)
EMBEDDER=gemini
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIM=768

# --- Automatic fixes: OFF by default. The system diagnoses and writes tickets without this. ---
FIX_ENABLED=false
FIX_MAX_ATTEMPTS=3            # 1-3
FIX_TIMEOUT_SECONDS=600
SANDBOX_IMAGE=python:3.13-slim
SANDBOX_MEMORY=512m
SANDBOX_CPUS=1.0
SANDBOX_TEST_TIMEOUT_SECONDS=120
REPOS_DIR=fixtures/repos      # mock mode: local checkouts named owner__name (real git source: Phase 10)

# --- Agent policy and run limits ---
FIX_THRESHOLD=0.8
MAX_LLM_CALLS_PER_RUN=30
RUN_TIMEOUT_SECONDS=300
RUN_TOKEN_BUDGET=200000

# --- Observability ---
# Empty = traces stay inside the process (log lines still get trace ids).
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
# The worker's /metrics endpoint. 0 disables it. Bind 0.0.0.0 only inside a container.
METRICS_ADDR=127.0.0.1
METRICS_PORT=9102
# Prices (USD per million tokens) for the cost estimate. Check your provider's price list; 0 = unknown.
PRICE_IN_PER_MTOK=0
PRICE_OUT_PER_MTOK=0
# Password for the optional local Grafana (docker compose --profile observability up -d)
GRAFANA_ADMIN_PASSWORD=change-me

# --- Real GitHub (optional; default is the fixtures) ---
# GITHUB_MODE=real
# A fine-grained token limited to the test repo(s): Contents RW, Pull requests RW, Metadata R. Never commit a real one.
# GITHUB_TOKEN=
# The only repositories reachable, comma-separated owner/name. Required in real mode.
# GITHUB_ALLOWED_REPOS=your-user/pipeline-doctor-sandbox
# GITHUB_API_URL=https://api.github.com
